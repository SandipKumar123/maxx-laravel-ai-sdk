      "type": "string"
    },
    "iat": {
      "title": "Iat",
      "type": "integer"
    },
    "exp": {
      "title": "Exp",
      "type": "integer"
    },
    "account_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Account Id",
      "type": "string"
    },
    "application_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Application Id",
      "type": "string"
    },
    "deployment_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Deployment Id",
      "type": "string"
    },
    "human_actor_ref": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
