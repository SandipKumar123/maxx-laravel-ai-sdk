      "maxItems": 10,
      "title": "Permissions",
      "type": "array"
    }
  },
  "required": [
    "iss",
    "aud",
    "sub",
    "iat",
    "exp",
    "account_id",
    "application_id",
    "deployment_id",
    "permissions"
